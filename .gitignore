__pycache__/
*.pyc

# Runtime caches
orbital-json-cache/

# Claude config extras
.superpowers/
.claude/skills/omnidex-design/
.claude/settings.local.json

# Local-only artifacts (WS0 working-tree cleanup)
# Packaged installer output (also matched by `/dist-installer` above; kept
# explicit for the trailing-slash directory form).
dist-installer/
# Local generated/scanned test asset library used by `pnpm gen:test-library`
# and smoke scans — large, machine-specific, NOT committed.
test-library/

# mdbook rendered output
docs/devbook/book/
